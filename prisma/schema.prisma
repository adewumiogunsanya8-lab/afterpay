// AfterPay - Prisma schema (Supabase / PostgreSQL)
//
// The database is the single source of truth for the catalogue, the markets and
// placed orders. `prisma/seed.ts` populates it; the app reads it through
// `lib/catalogue.ts`. Nothing in the runtime path generates data any more.
//
// Naming: models are PascalCase, tables/columns are snake_case (@map) so the
// schema reads naturally in the Supabase SQL editor.

generator client {
  provider = "prisma-client"
  // Prisma 7 no longer generates into node_modules: the output path is
  // required, and the app imports PrismaClient from here (see lib/db.ts).
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection strings live in prisma.config.ts (DATABASE_URL for the app,
  // DIRECT_URL for the CLI). Prisma 7 removed `url`/`directUrl` from here.
}

// ---------------------------------------------------------------- enumerations

/// Currencies the storefront can quote. USD only.
enum CurrencyCode {
  USD
}

/// Markets (country + currency + fulfilment rules) the storefront serves.
/// The store is US-only, so `UK` was removed once GBP pricing was dropped.
enum CountryCode {
  US
}

/// Delivery options offered per market.
enum ShippingMethodId {
  standard
  express
}

/// How the shopper chose to pay for an order or order item.
enum PaymentChoice {
  full
  installments
}

/// Lifecycle of a placed order.
enum OrderStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

// --------------------------------------------------------------------- markets

/**
 * The storefront's market: country, currency, tax rate and fulfilment rules.
 *
 * The store is US-only and quotes in USD, so this table holds a single row. It
 * stays a table (rather than hard-coded config) so tax rates, shipping
 * thresholds and delivery copy remain editable in the database.
 *
 * Loaded once in the root layout and provided to client components through
 * `lib/markets-context.tsx`, so currency formatting stays synchronous in the
 * browser.
 */
model Market {
  code CountryCode @id
  /// Name of the country.
  name String
  /// Short label used in dense layouts.
  shortName String
  /// Flag emoji.
  flag String
  currency CurrencyCode
  /// Symbol used in prose, e.g. next to "from".
  currencySymbol String
  /// Intl locale used for price formatting.
  locale String
  /// Flat standard shipping price, in local currency.
  standardShipping Decimal @db.Decimal(10, 2)
  /// Express shipping price, in local currency.
  expressShipping Decimal @db.Decimal(10, 2)
  /// Order subtotal above which standard shipping is free.
  freeShippingThreshold Decimal @db.Decimal(10, 2)
  /// Estimated tax rate applied to (subtotal + shipping).
  estimatedTaxRate Decimal @db.Decimal(6, 4)
  /// Human label for the estimated tax row.
  estimatedTaxLabel String
  /// Days shown in the standard delivery estimate.
  standardDeliveryDays String
  /// Days shown in the express delivery estimate.
  expressDeliveryDays String
  /// Returns copy shown in the UI.
  returnsSummary String
  /// Market-specific marketing / compliance copy.
  /// Shape: { shippingNote, freeReturnsNote, installmentNote }
  messaging Json
  /// Whether this is the market used when nothing is stored locally.
  isDefault Boolean @default(false)
  /// Display order in the market selector.
  sortOrder Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices ProductPrice[]
  orders Order[]

  @@index([sortOrder], map: "markets_sort_order_idx")
  @@map("markets")
}

// ------------------------------------------------------------------- catalogue

/// A browsable category. Exactly one parent for every product.
model Category {
  /// Generated by Postgres (`gen_random_uuid()`), so categories can be created
  /// from the admin dashboard without the caller inventing an id.
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  name String
  slug String @unique
  /// Short line used on category cards.
  tagline String
  /// Longer description shown at the top of the category page.
  description String
  /// Key into the image generator's illustration set.
  artKey String
  /// Price envelope, in USD, shown on the category page.
  priceMin Decimal @db.Decimal(10, 2)
  priceMax Decimal @db.Decimal(10, 2)
  /// Editorial banner image, derived from `artKey` at seed time.
  bannerImage String
  /// Display order across the site.
  sortOrder Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]
  specs    CategorySpec[]

  @@index([sortOrder], map: "categories_sort_order_idx")
  @@map("categories")
}

/// Category-level specification rows merged into every product in the category.
model CategorySpec {
  id        String @id @default(cuid())
  categoryId String @map("category_id")
  /// Row label, e.g. "Energy rating".
  label String
  /// Row value, e.g. "Energy rating A to A++".
  value String
  /// Order of the row on the product page.
  position Int @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, label], map: "category_specs_category_id_label_key")
  @@index([categoryId, position], map: "category_specs_category_id_position_idx")
  @@map("category_specs")
}

/// A sellable product.
///
/// Money lives in `ProductPrice` (one row per market) so each market carries its
/// own price list rather than converting at runtime.
model Product {
  /// Generated by Postgres (`gen_random_uuid()`), so products can be created
  /// from the admin dashboard without the caller inventing an id.
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  sku String @unique
  slug String @unique
  name String
  brand String
  categoryId String @map("category_id")
  shortDescription String @map("short_description")
  description String
  /// Main product image; also `ProductImage.position = 0`.
  image String
  rating Decimal @db.Decimal(2, 1)
  reviewCount Int @map("review_count")
  stock Int @default(0)
  /// Highlighted on the homepage rail.
  featured Boolean @default(false)
  /// Released within the new-arrival window.
  isNew Boolean @default(false) @map("is_new")
  color String
  /// Deterministic 0-100 score used for "Recommended" sorting.
  popularity Int @default(0)
  /// Sales count used for "Best Sellers".
  soldCount Int @map("sold_count")
  /// Date the product was released, used for "Newest" sorting.
  releasedAt DateTime @map("released_at")
  /// Display order within its category (the seed position).
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category    Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prices      ProductPrice[]
  images      ProductImage[]
  specs       ProductSpec[]
  tags        ProductTag[]
  installment InstallmentConfig?
  reviews     Review[]
  orderItems  OrderItem[]

  @@index([categoryId], map: "products_category_id_idx")
  @@index([brand], map: "products_brand_idx")
  @@index([featured], map: "products_featured_idx")
  @@index([isNew], map: "products_is_new_idx")
  @@index([releasedAt], map: "products_released_at_idx")
  @@index([soldCount], map: "products_sold_count_idx")
  @@index([popularity], map: "products_popularity_idx")
  @@index([categoryId, sortOrder], map: "products_category_id_sort_order_idx")
  @@map("products")
}

/// One row per market: the product's price in that market's currency.
model ProductPrice {
  id String @id @default(cuid())
  productId String @map("product_id")
  marketCode CountryCode @map("market_code")
  /// Selling price in this market's currency.
  price Decimal @db.Decimal(10, 2)
  /// Pre-discount "was" price in this market's currency.
  compareAtPrice Decimal @db.Decimal(10, 2) @map("compare_at_price")
  /// 0 when there is no discount, otherwise 5-60.
  discountPercent Int @default(0) @map("discount_percent")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  market  Market  @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@unique([productId, marketCode], map: "product_prices_product_id_market_code_key")
  @@index([marketCode, price], map: "product_prices_market_code_price_idx")
  @@map("product_prices")
}

/// Gallery image. Position 0 mirrors `Product.image`.
model ProductImage {
  id String @id @default(cuid())
  productId String @map("product_id")
  url String
  /// Order within the gallery.
  position Int @default(0)
  /// Alternative text for the image.
  alt String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position], map: "product_images_product_id_position_key")
  @@map("product_images")
}

/// A single specification row on the product page.
model ProductSpec {
  id String @id @default(cuid())
  productId String @map("product_id")
  label String
  value String
  position Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position], map: "product_specs_product_id_position_key")
  @@map("product_specs")
}

/// A search/filter tag attached to a product.
model ProductTag {
  id String @id @default(cuid())
  productId String @map("product_id")
  tag String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tag], map: "product_tags_product_id_tag_key")
  @@index([tag], map: "product_tags_tag_idx")
  @@map("product_tags")
}

/// Installment (BNPL) configuration attached to every product.
model InstallmentConfig {
  productId String @id @map("product_id")
  /// Whether this product may be shown with a "Pay in installments" option.
  eligible Boolean @default(false)
  /// The period highlighted on the product page by default.
  suggestedMonths Int @map("suggested_months")
  /// Installment periods the calculator offers for this product.
  availableMonths Int[] @map("available_months")
  /// Smallest order value the calculator will split, in USD.
  minAmountUsd Decimal @db.Decimal(10, 2) @map("min_amount_usd")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([eligible], map: "installment_configs_eligible_idx")
  @@map("installment_configs")
}

/// A customer review of a product.
model Review {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  productId String @map("product_id")
  author String
  location String
  rating Int
  title String
  body String
  /// Date the review was left.
  reviewDate DateTime @map("review_date")
  /// Whether the reviewer is marked as a verified buyer.
  verified Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, reviewDate], map: "reviews_product_id_review_date_idx")
  @@index([rating], map: "reviews_rating_idx")
  @@map("reviews")
}

// ---------------------------------------------------------------------- orders

/// An order placed through checkout.
///
/// Money columns are snapshots in `currency`, not foreign keys to live prices -
/// an order must never change because the catalogue did.
model Order {
  id String @id @default(cuid())
  /// Human-facing order reference shown on the confirmation screen.
  reference String @unique
  marketCode CountryCode @map("market_code")
  currency CurrencyCode

  // Contact
  email String
  firstName String @map("first_name")
  lastName String @map("last_name")
  phone String?

  // Shipping address
  address1 String
  address2 String?
  city String
  state String
  postcode String

  // Fulfilment
  shippingMethod ShippingMethodId @map("shipping_method")
  /// Label captured at checkout, e.g. "United States express".
  shippingLabel String @map("shipping_label")

  // Money
  subtotal Decimal @db.Decimal(10, 2)
  /// Total discount already applied to the line items.
  savings Decimal @db.Decimal(10, 2) @default(0)
  shipping Decimal @db.Decimal(10, 2)
  tax Decimal @db.Decimal(10, 2)
  total Decimal @db.Decimal(10, 2)
  /// Label captured at checkout, e.g. "Estimated sales tax".
  taxLabel String @map("tax_label")
  itemCount Int @map("item_count")

  // Payment
  paymentChoice PaymentChoice @map("payment_choice")
  /// 0 for full payment, mixed choices or different installment terms.
  installmentMonths Int @default(0) @map("installment_months")
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")

  status OrderStatus @default(pending)
  placedAt DateTime @default(now()) @map("placed_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  market       Market             @relation(fields: [marketCode], references: [code], onDelete: Restrict)
  items        OrderItem[]
  installments OrderInstallment[]

  @@index([marketCode], map: "orders_market_code_idx")
  @@index([status], map: "orders_status_idx")
  @@index([placedAt], map: "orders_placed_at_idx")
  @@index([email], map: "orders_email_idx")
  @@map("orders")
}

/// A line item on an order.
///
/// Product fields are denormalised snapshots so the order stays accurate even
/// if the product is renamed, re-priced or deleted later.
model OrderItem {
  id String @id @default(cuid())
  orderId String @map("order_id")
  /// Null when the product has since been removed from the catalogue.
  productId String? @map("product_id")
  sku String
  name String
  brand String
  image String
  /// Unit price in the order's currency.
  unitPrice Decimal @db.Decimal(10, 2) @map("unit_price")
  /// Pre-discount unit price in the order's currency.
  compareAtUnitPrice Decimal @db.Decimal(10, 2) @map("compare_at_unit_price")
  quantity Int
  /// unitPrice * quantity, snapshotted so totals never drift.
  lineTotal Decimal @db.Decimal(10, 2) @map("line_total")
  /// Payment preference selected for this product at checkout.
  paymentChoice PaymentChoice @default(full) @map("payment_choice")
  /// 0 when paid in full, otherwise the chosen installment period.
  installmentMonths Int @default(0) @map("installment_months")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([orderId, sku], map: "order_items_order_id_sku_key")
  @@index([productId], map: "order_items_product_id_idx")
  @@map("order_items")
}

/// One illustrative payment of an installment plan.
///
/// No payment processor is involved: these rows record what the schedule would
/// be, and exist so the confirmation screen is reproducible.
model OrderInstallment {
  id String @id @default(cuid())
  orderId String @map("order_id")
  /// 1-based payment number.
  position Int
  /// Date the payment would be taken.
  dueDate DateTime @map("due_date")
  amount Decimal @db.Decimal(10, 2)
  /// e.g. "Payment 1" or "Final payment".
  label String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, position], map: "order_installments_order_id_position_key")
  @@map("order_installments")
}

// ------------------------------------------------------------------- admin auth

/// A dashboard operator. Passwords are never stored in plain text.
model AdminUser {
  id String @id @default(cuid())
  email String @unique
  name String
  /// scrypt hash, encoded as `scrypt$<salt>$<hash>`.
  passwordHash String @map("password_hash")
  /// Whether the account may sign in to the dashboard.
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  sessions AdminSession[]

  @@map("admin_users")
}

/// A server-side session. Only a hash of the token is stored, so a database
/// leak cannot be replayed as a login.
model AdminSession {
  id String @id @default(cuid())
  /// SHA-256 of the opaque session token held in the browser cookie.
  tokenHash String @unique @map("token_hash")
  adminId String @map("admin_id")
  /// When the session stops being valid.
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  /// Free-form audit trail, e.g. the user agent that signed in.
  userAgent String? @map("user_agent")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "admin_sessions_admin_id_idx")
  @@index([expiresAt], map: "admin_sessions_expires_at_idx")
  @@map("admin_sessions")
}
