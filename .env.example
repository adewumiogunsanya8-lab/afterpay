# ---------------------------------------------------------------------------
# Copy to `.env` and fill in the Supabase database and Storage settings:
#
#   Copy-Item .env.example .env
#
# Both come from the Supabase dashboard: Project -> Settings -> Data API.
# Use the values in the "Connection string" panel, which are pooler hosts.
#
# IMPORTANT: use the pooler hostnames, not the direct `*.supabase.co` host.
# The direct host refuses IPv4 connections from most networks, and the pooler
# is what keeps the app inside the connection limit in any case.
# ---------------------------------------------------------------------------

# The running app. Transaction pooler (port 6543).
#
#   sslmode=no-verify  keeps the connection encrypted but skips certificate
#                      verification. Good enough for local development; for
#                      production download the Supabase CA and use
#                      `sslmode=verify-full&sslrootcert=<path to ca.crt>`.
#   connect_timeout=30 stops a cold pooler connection from tripping the
#                      Next.js build timeout.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify&connect_timeout=30"

# The Prisma CLI (migrations, `db seed`, `db push`). Session pooler (port 5432).
#
# The pooler cannot run DDL, which is why migrations need the 5432 endpoint even
# though the app itself uses 6543.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=no-verify&connect_timeout=30"

# Supabase Storage image uploads (server-side only; never prefix the key with NEXT_PUBLIC_).
# Create a public bucket named `images` in Supabase Storage.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
